# =============================================================================
# ENTERPRISE FINANCIAL ASSISTANT — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development                  # development | staging | production
APP_SECRET_KEY=CHANGE_ME_32_BYTES    # 32-byte secret for internal signing
LOG_LEVEL=INFO                       # DEBUG | INFO | WARN | ERROR

# --- PostgreSQL / TimescaleDB ---
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=financial_assistant
POSTGRES_USER=fa_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASS  # Min 24 chars in production
# WORM audit table — separate schema to prevent accidental mutation
TIMESCALE_AUDIT_SCHEMA=audit

# --- Redis Enterprise ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS
REDIS_TLS=false                      # Set true in production
REDIS_MARKET_CHANNEL=market_ticks
REDIS_PORTFOLIO_CHANNEL=portfolio_updates

# --- Qdrant Vector DB ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=CHANGE_ME_QDRANT_KEY  # Leave empty for local dev
QDRANT_COLLECTION_FILINGS=financial_filings
QDRANT_COLLECTION_KNOWLEDGE=market_knowledge

# --- Apache Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_MARKET_TICKS=market.ticks
KAFKA_TOPIC_PORTFOLIO_EVENTS=portfolio.events
KAFKA_TOPIC_ORDER_EVENTS=order.events
KAFKA_CONSUMER_GROUP=financial_assistant_cg
KAFKA_AUTO_OFFSET_RESET=latest

# --- vLLM (Qwen-2.5-72B-Instruct, FP8/AWQ) ---
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-72B-Instruct-AWQ
VLLM_API_KEY=CHANGE_ME_VLLM_KEY     # Set if vLLM is behind auth
VLLM_MAX_TOKENS=4096
VLLM_TEMPERATURE=0.1                 # Low temp for deterministic financial responses
VLLM_TOP_P=0.9

# --- Auth0 (OAuth2 / OIDC) ---
AUTH0_DOMAIN=YOUR_TENANT.auth0.com
AUTH0_AUDIENCE=https://api.financial-assistant.com
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=CHANGE_ME_AUTH0_SECRET
AUTH0_ALGORITHMS=RS256

# --- AES-256-GCM Field-Level Encryption ---
# Must be exactly 32 bytes (256 bits), base64-encoded
FIELD_ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_KEY==

# --- Paper Trading Mock ---
PAPER_TRADING_INITIAL_CASH=100000.0  # USD
PAPER_TRADING_LATENCY_MS=50          # Simulated fill latency
PAPER_TRADING_SLIPPAGE_BPS=2         # 2 basis points slippage

# --- Market Data (yfinance) ---
MARKET_DATA_PROVIDER=yfinance
MARKET_TICK_INTERVAL_SECONDS=5       # Polling interval for yfinance
MARKET_DEFAULT_TICKERS=AAPL,MSFT,GOOGL,AMZN,META,NVDA,TSLA,SPY,QQQ,BRK-B

# --- SEC EDGAR RAG ---
SEC_EDGAR_USER_AGENT=FinancialAssistant/1.0 contact@example.com
SEC_PRELOAD_TICKERS=AAPL,MSFT,GOOGL,AMZN,META,NVDA,TSLA
SEC_PRELOAD_YEARS=2023,2024
SEC_FILING_TYPES=10-K,10-Q
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large
EMBEDDING_BATCH_SIZE=32

# --- Risk-Free Rate (for Sharpe/Sortino) ---
RISK_FREE_RATE_ANNUAL=0.0525        # 5.25% — update to current T-bill rate

# --- Compliance ---
MIFID2_DISCLAIMER=This analysis is generated by an AI system and does not constitute financial advice. Past performance is not indicative of future results. Please consult a qualified financial advisor before making investment decisions. Capital at risk.
SEC_DISCLAIMER=This material is for informational purposes only and is not intended as investment advice. The information provided does not take into account your individual investment objectives, financial situation, or needs.

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://financial-assistant.example.com

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- Envoy Proxy ---
ENVOY_ADMIN_PORT=9901
ENVOY_HTTP_PORT=8080
