FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
# FlagEmbedding is large — only in RAG worker image
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/

# Pre-download models at build time to avoid cold start latency
# (skip in dev with --build-arg SKIP_MODEL_DOWNLOAD=1)
ARG SKIP_MODEL_DOWNLOAD=0
RUN if [ "$SKIP_MODEL_DOWNLOAD" = "0" ]; then \
    python -c "from FlagEmbedding import BGEM3FlagModel; BGEM3FlagModel('BAAI/bge-m3')"; \
    fi

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

CMD ["python", "-m", "backend.rag.worker"]
